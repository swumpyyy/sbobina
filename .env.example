# Copia questo file in ".env" e inserisci le tue chiavi.

# Gli appunti li scrive un modello AI gratuito sul tuo computer, tramite Ollama (https://ollama.com):
# installa l'app, aprila ed esegui una volta `ollama pull gemma4:12b`. Nessuna chiave necessaria.
# Facoltativa e a pagamento: per usare Claude imposta SBOBINA_MODELLO=claude-opus-5-5 e la chiave qui sotto.
#ANTHROPIC_API_KEY=

# Facoltative: servizi cloud di trascrizione (a pagamento oltre la quota gratuita).
# Con una chiave l'audio viene trascritto da quel servizio; con entrambe viene trascritto
# da due motori diversi e l'AI confronta le due versioni parola per parola.
# Senza chiavi si usa Whisper in locale: gratis e privato.
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Impostazioni avanzate (i valori indicati sono quelli predefiniti) ---

# Motori di trascrizione: auto, oppure un elenco tra assemblyai, elevenlabs, whisper.
#SBOBINA_MOTORI=auto

# Modello che scrive gli appunti (gratuito, via Ollama). Con meno di 16 GB di RAM prova gemma4:latest.
# Il livello di ragionamento (low, medium, high, xhigh, max) vale solo per Claude.
#SBOBINA_MODELLO=gemma4:12b
#SBOBINA_SFORZO=high
#SBOBINA_SFORZO_REVISIONE=medium

# Controllo finale degli appunti contro la trascrizione (1 = attivo, 0 = disattivo).
#SBOBINA_VERIFICA=1

# Lingua delle lezioni (codice ISO a due lettere).
#SBOBINA_LINGUA=it

# Whisper locale: modello (large-v3 = più accurato, large-v3-turbo = più veloce) e dispositivo (auto, cpu, cuda).
#SBOBINA_WHISPER_MODELLO=large-v3
#SBOBINA_WHISPER_DISPOSITIVO=auto

# Cartella dove vengono salvate lezioni e appunti.
#SBOBINA_DATI=dati
