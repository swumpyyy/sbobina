# Copia questo file in ".env" e inserisci le tue chiavi.

# Obbligatoria: chiave API di Anthropic (https://console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# Facoltative ma consigliate per la massima accuratezza.
# Con una chiave l'audio viene trascritto da quel servizio; con entrambe viene trascritto
# da due motori diversi e Claude confronta le due versioni parola per parola.
# Senza chiavi si usa Whisper in locale (gratis, ma lento senza GPU).
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Impostazioni avanzate (i valori indicati sono quelli predefiniti) ---

# Motori di trascrizione: auto, oppure un elenco tra assemblyai, elevenlabs, whisper.
#SBOBINA_MOTORI=auto

# Modello Claude e livello di ragionamento per appunti/verifica (low, medium, high, xhigh, max).
#SBOBINA_MODELLO=claude-opus-5-5
#SBOBINA_SFORZO=high
#SBOBINA_SFORZO_REVISIONE=medium

# Controllo finale degli appunti contro la trascrizione (1 = attivo, 0 = disattivo).
#SBOBINA_VERIFICA=1

# Lingua delle lezioni (codice ISO a due lettere).
#SBOBINA_LINGUA=it

# Whisper locale: modello (large-v3 = più accurato, large-v3-turbo = più veloce) e dispositivo (auto, cpu, cuda).
#SBOBINA_WHISPER_MODELLO=large-v3
#SBOBINA_WHISPER_DISPOSITIVO=auto

# Cartella dove vengono salvate lezioni e appunti.
#SBOBINA_DATI=dati
